{
  "cli": {
    "version": ">= 23.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.10.0",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "auto"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "live",
        "EXPO_PUBLIC_WEB_URL": "https://promptedpast.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.vladshusterman.promptedpast"
      }
    }
  }
}
