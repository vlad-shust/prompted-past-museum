{
  "compilerOptions": {
    "strict": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "../src/content/**/*.ts", "../src/types/**/*.ts"]
}
